# whistle-dictate — Hyprland example (copy what you need, don't symlink)
#
# Install once: ln -sf /path/to/whistle-dictate/.venv/bin/whistle-dictate ~/.local/bin/
# (or: uv tool install -e /path/to/whistle-dictate) so the binds below survive moves.

# Toggle: one keypress to start, press again to stop + paste at cursor.
# (True hold needs bindr, which Hyprland 0.57 Lua doesn't expose — toggle is
# also what Hex docs recommend: release timing is unreliable with modifiers.)
bind = ALT, Space, exec, ~/.local/bin/whistle-dictate toggle
bind = CTRL, Space, exec, ~/.local/bin/whistle-dictate toggle
bind = , End, exec, ~/.local/bin/whistle-dictate toggle

# Glass card: float, no focus steal, top-center (position via your layout).
windowrule = float, title:^(wd-osd.*)$
windowrule = nofocus, title:^(wd-osd.*)$

# --- Hyprland 0.57 Lua equivalents (config/binds.lua + autostart.lua) ---
# hl.bind("ALT + Space", hl.dsp.exec_cmd(WD .. " toggle"))  -- WD = "~/.local/bin/whistle-dictate"
# hl.exec_cmd(WD .. " warm")  -- at login: pre-downloads whistle.cact so the first dictation is instant
